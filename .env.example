# ── Source 1: aisstream.io (free, shore-station AIS, streaming) ──
AIS_API_KEY=your_aisstream_api_key_here

# ── Where the last known positions are kept ──
# On Railway: attach a Volume to the service; its mount path is picked up automatically.
# Without a volume every redeploy starts with an empty map until each ship is heard again.
# DATA_DIR=/data

# ── Source 2 (optional): polled only for vessels with no fix in FALLBACK_STALE_MIN ──
# vesselfinder | myshiptracking   (both bill per position returned)
# FALLBACK_PROVIDER=vesselfinder
# FALLBACK_API_KEY=
# FALLBACK_POLL_MIN=60
# FALLBACK_STALE_MIN=60

# ── Optional: require this token to save voyage data / manual positions ──
# EDIT_TOKEN=

# ── Optional: set an MMSI without editing fleet.json ──
# MMSI_OVERRIDES=harilaos-junior:538000000

# PORT=3000   (Railway sets this itself)
